<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - KLH Canteen</title>
  <style>
    /* Full page background */
    body {
      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
                  url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1600') no-repeat center center fixed;
      background-size: cover;
      min-height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Login container */
    .login-container {
      background: rgba(255, 255, 255, 0.92);
      max-width: 400px;
      width: 90%;
      padding: 40px;
      border-radius: 15px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.3);
      backdrop-filter: blur(5px);
    }

    h1 {
      color: #1a3c6e;
      text-align: center;
      margin-bottom: 10px;
    }

    h2 {
      color: #666;
      text-align: center;
      font-size: 18px;
      margin-bottom: 30px;
    }

    input, button {
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
      box-sizing: border-box;
    }

    input:focus {
      outline: none;
      border-color: #1a3c6e;
    }

    button {
      background: #1a3c6e;
      color: white;
      border: none;
      cursor: pointer;
      font-weight: bold;
      transition: 0.3s;
    }

    button:hover {
      background: #2a5c8e;
    }

    /* Divider */
    .or-divider {
      text-align: center;
      color: #888;
      margin: 20px 0;
      font-size: 14px;
    }

    /* Footer Links */
    .footer-links {
      text-align: center;
      margin-top: 20px;
      font-size: 14px;
    }

    .footer-links a {
      color: #1a3c6e;
      text-decoration: none;
      font-weight: bold;
    }

    .footer-links a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <h1>🏫 KLH University</h1>
    <h2>Welcome to Canteen</h2>

    <!-- Normal Email/Password Login -->
    <form action="/login" method="POST">
      <input type="email" placeholder="Email Address" name="email" required>
      <input type="password" placeholder="Password" name="password" required>
      <button type="submit">Login</button>
    </form>

    <!-- Divider -->
    <div class="or-divider">or</div>

    <!-- OTP Login Button -->
    <div style="text-align: center; margin-top: 20px;">
        <button type="button" id="otpBtn" onclick="startOtp()" style="background: #4285F4; width: 100%;">📧 Login with Gmail OTP</button>
    </div>

    <!-- OTP Section (Hidden initially) -->
    <div id="otpSection" style="display: none; margin-top: 15px;">
        <input type="text" id="otpInput" placeholder="Enter 6-digit code" maxlength="6" style="text-align: center; letter-spacing: 5px; font-size: 20px;">
        <button type="button" onclick="verifyOtp()" style="background: #28a745; width: 100%;">Verify & Login</button>
        <p style="font-size: 12px; color: #666; text-align: center; margin-top: 5px;">Code sent to your email. Valid for 5 mins.</p>
    </div>

    <!-- Footer -->
    <div class="footer-links">
      <p>Don't have an account? <a href="/signup">Sign Up</a></p>
      <p><a href="/">← Back to Home</a></p>
    </div>
  </div>

  <!-- ============ OTP JAVASCRIPT ============ -->
  <script>
    let userEmail = "";

    async function startOtp() {
      userEmail = prompt("Enter your Gmail address:");
      if (!userEmail) return;

      const btn = document.getElementById('otpBtn');
      btn.innerText = "Sending Code...";
      btn.disabled = true;

      const response = await fetch('/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: userEmail })
      });

      const data = await response.json();

      if (data.success) {
        alert("✅ Code sent! Check your email.");
        document.getElementById('otpSection').style.display = 'block';
      } else {
        alert("❌ Error: " + data.message);
      }
      btn.innerText = "📧 Login with Gmail OTP";
      btn.disabled = false;
    }

    async function verifyOtp() {
      const otp = document.getElementById('otpInput').value;
      const response = await fetch('/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: userEmail, otp: otp })
      });

      const data = await response.json();

      if (data.success) {
        window.location.href = '/';
      } else {
        alert("❌ " + data.message);
      }
    }
  </script>
</body>
</html>
