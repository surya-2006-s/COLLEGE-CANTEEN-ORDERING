<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Payment - College Canteen</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .payment-container {
            max-width: 500px;
            margin: 50px auto;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            text-align: center;
        }
        .payment-container h2 {
            margin-bottom: 20px;
            color: #333;
        }
        .upi-id {
            font-size: 18px;
            font-weight: bold;
            color: #ff6b6b;
            margin: 10px 0 20px 0;
        }
        .qr-placeholder {
            width: 200px;
            height: 200px;
            background: #f0f0f0;
            border: 2px dashed #ccc;
            border-radius: 10px;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            font-size: 14px;
        }
        .total-amount {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 20px 0;
        }
        .btn-pay {
            background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
            color: white;
            border: none;
            padding: 15px 40px;
            border-radius: 30px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-top: 20px;
        }
        .btn-pay:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255,107,107,0.4);
        }
        .classroom-info {
            color: #666;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <%- include('header') %>

    <div class="container">
        <div class="payment-container">
            <h2>📱 QR Payment</h2>
            
            <div class="classroom-info">
                <p><strong>Classroom:</strong> <%= classroom %></p>
            </div>

            <div class="upi-id">
                UPI ID: <strong><%= upiId %></strong>
            </div>

            <!-- QR Code Placeholder (You can replace this with a real QR image later) -->
            <div class="qr-placeholder">
                <span>Scan to Pay<br>QR Code</span>
            </div>

            <div class="total-amount">
                Total: ₹<%= total %>
            </div>

            <!-- REAL PAYMENT BUTTON WITH RAZORPAY -->
            <button id="pay-button" class="btn-pay">💳 Pay Now</button>
        </div>
    </div>

    <!-- LOAD RAZORPAY SCRIPT -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        document.getElementById('pay-button').onclick = async function(e) {
            e.preventDefault();
            
            // 1. Tell server to create an order
            const response = await fetch('/create-razorpay-order', { method: 'POST' });
            const order = await response.json();

            // 2. Setup Razorpay Options
            const options = {
                key: 'rzp_test_TNKhAetJpFJyCT',
// REPLACE WITH YOUR KEY ID
                amount: order.amount,
                currency: order.currency,
                name: 'KLH College Canteen',
                description: 'Canteen Order Payment',
                order_id: order.order_id,
                handler: async function (response) {
                    // 3. Auto verify payment on the backend
                    const verifyRes = await fetch('/verify-payment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            razorpay_order_id: response.razorpay_order_id,
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_signature: response.razorpay_signature
                        })
                    });
                    
                    const verifyData = await verifyRes.json();
                    if (verifyData.success) {
                        // 4. Instant Redirect to Home Page
                        window.location.href = verifyData.redirectUrl;
                    } else {
                        alert("Payment Failed or Not Verified.");
                    }
                },
                prefill: {
                    name: '<%= typeof user !== "undefined" && user ? user.full_name : "Guest" %>',
                    email: '<%= user ? user.email : "" %>',
                    contact: '9999999999'
                },
                theme: {
                    color: '#ff6b6b'
                }
            };

            const rzp1 = new Razorpay(options);
            rzp1.open();
        };
    </script>
</body>
</html>
