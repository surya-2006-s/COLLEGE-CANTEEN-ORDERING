<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UPI ID Payment - College Canteen</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .upi-container {
            max-width: 500px;
            margin: 50px auto;
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(255,107,107,0.3);
            text-align: center;
        }
        .upi-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .upi-header h2 {
            color: #ff6b6b;
            font-size: 28px;
            margin-bottom: 10px;
        }
        .amount-display {
            font-size: 48px;
            font-weight: bold;
            color: #ff6b6b;
            margin: 20px 0;
        }
        .pay-button {
            background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
            color: white;
            width: 100%;
            padding: 18px;
            border: none;
            border-radius: 15px;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
            margin: 20px 0;
            box-shadow: 0 10px 20px rgba(255,107,107,0.3);
            transition: all 0.3s;
        }
        .pay-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(255,107,107,0.4);
        }
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #ff6b6b;
            text-decoration: none;
        }
        .note {
            background: #fff3cd;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            font-size: 14px;
            text-align: left;
        }
    </style>
</head>
<body>
    <%- include('header') %>

    <div class="container">
        <div class="upi-container">
            <div class="upi-header">
                <h2>💳 Secure Payment</h2>
                <p style="color: #666;">Complete your order securely via Razorpay</p>
            </div>

            <!-- Amount Display -->
            <div class="amount-display">
                ₹<%= total %>
            </div>

            <!-- Note -->
            <div class="note">
                <strong>📌 Secure Gateway:</strong> You will be redirected to a secure Razorpay popup to complete your payment using UPI, Card, or Netbanking.
            </div>

            <!-- Razorpay Pay Button -->
            <button id="razorpay-pay-btn" class="pay-button">
                💰 Pay ₹<%= total %> Now
            </button>

            <!-- Back Link -->
            <a href="/payment" class="back-link">← Back to Payment Options</a>
        </div>
    </div>

    <!-- LOAD RAZORPAY SCRIPT -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        document.getElementById('razorpay-pay-btn').onclick = async function(e) {
            e.preventDefault();
            
            // 1. Tell server to create an order
            const response = await fetch('/create-razorpay-order', { method: 'POST' });
            const order = await response.json();

            // 2. Setup Razorpay Options
            const options = {
                key: 'rzp_live_TNdspwXjDdccUR', // Your Live Key ID
                amount: order.amount,
                currency: order.currency,
                name: 'KLH College Canteen',
                description: 'Canteen Order Payment',
                order_id: order.order_id,
                handler: async function (response) {
                    // 3. Auto verify payment on the backend
                    const verifyRes = await fetch('/verify-payment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            razorpay_order_id: response.razorpay_order_id,
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_signature: response.razorpay_signature
                        })
                    });                    
                    const verifyData = await verifyRes.json();
                    if (verifyData.success) {
                        // 4. Instant Redirect to Home Page
                        window.location.href = verifyData.redirectUrl;
                    } else {
                        alert("Payment Failed or Not Verified.");
                    }
                },
                prefill: {
                    name: '<%= typeof user !== "undefined" && user ? user.full_name : "Guest" %>',
                    email: '<%= typeof user !== "undefined" && user ? user.email : "" %>',
                    contact: '9999999999'
                },
                theme: {
                    color: '#ff6b6b'
                }
            };
            const rzp1 = new Razorpay(options);
            rzp1.open();
        };
    </script>
</body>
</html>
