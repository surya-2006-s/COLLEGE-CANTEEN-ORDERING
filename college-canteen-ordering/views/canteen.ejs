<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KLH Canteen - Order Food</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f0f4f8;
            padding: 20px;
        }

        .header {
            background: #1a3c6e;
            color: white;
            padding: 20px 30px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header h1 {
            font-size: 24px;
        }

        .header h1 span {
            color: #f39c12;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-right a {
            color: white;
            text-decoration: none;
            background: rgba(255,255,255,0.2);
            padding: 8px 16px;
            border-radius: 8px;
            transition: 0.3s;
        }

        .header-right a:hover {
            background: rgba(255,255,255,0.3);
        }

        .cart-badge {
            background: #e67e22;
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: bold;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .categories {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .category-btn {
            padding: 10px 25px;
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 25px;
            cursor: pointer;
            transition: 0.3s;
            font-weight: 600;
            color: #333;
        }

        .category-btn.active {
            background: #1a3c6e;
            color: white;
            border-color: #1a3c6e;
        }

        .category-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .item-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: 0.3s;
            text-align: center;
        }

        .item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

        .item-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }

        .item-name {
            font-size: 18px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
        }

        .item-price {
            font-size: 20px;
            color: #1a3c6e;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .add-btn {
            padding: 10px 25px;
            background: #1a3c6e;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }

        .add-btn:hover {
            background: #2a5c8e;
            transform: scale(1.05);
        }

        .cart-section {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-top: 20px;
        }

        .cart-section h2 {
            margin-bottom: 15px;
            color: #333;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .cart-total {
            font-size: 22px;
            font-weight: 700;
            color: #1a3c6e;
            margin: 20px 0;
            text-align: right;
        }

        .pay-btn {
            width: 100%;
            padding: 15px;
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
        }

        .pay-btn:hover {
            background: #2ecc71;
            transform: scale(1.02);
        }

        .pay-btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
        }

        .empty-cart {
            text-align: center;
            color: #999;
            padding: 20px;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 10px;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #1a3c6e;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #333;
            color: white;
            padding: 15px 25px;
            border-radius: 10px;
            display: none;
            animation: slideIn 0.5s ease;
            z-index: 999;
        }

        @keyframes slideIn {
            from { transform: translateX(100px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        @media (max-width: 600px) {
            .header {
                flex-direction: column;
                text-align: center;
                gap: 15px;
            }
            .header-right {
                flex-wrap: wrap;
                justify-content: center;
            }
            .items-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🍽️ KLH <span>Canteen</span></h1>
            <div class="header-right">
                <span>👋 Welcome, <strong><%= user ? user.full_name || user.email : 'Guest' %></strong></span>
                <span class="cart-badge">🛒 <span id="cartCount">0</span> items</span>
                <a href="/logout">🚪 Logout</a>
            </div>
        </div>

        <!-- Categories -->
        <div class="categories">
            <button class="category-btn active" data-category="all">📋 All</button>
            <button class="category-btn" data-category="cool-drinks">🥤 Cool Drinks</button>
            <button class="category-btn" data-category="fruit-juices">🍹 Fruit Juices</button>
            <button class="category-btn" data-category="icecreams">🍦 Ice Creams</button>
            <button class="category-btn" data-category="packet-snacks">🍿 Packet Snacks</button>
        </div>

        <!-- Items Grid -->
        <div class="items-grid" id="itemsGrid">
            <!-- Items will be loaded by JavaScript -->
        </div>

        <!-- Cart Section -->
        <div class="cart-section">
            <h2>🛒 Your Cart</h2>
            <div id="cartItems">
                <div class="empty-cart">Your cart is empty. Add some delicious items!</div>
            </div>
            <div class="cart-total">Total: ₹<span id="totalAmount">0</span></div>
            <button class="pay-btn" id="payBtn" disabled>💳 Proceed to Payment</button>
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p style="margin-top:10px;">Processing...</p>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast"></div>

    <script>
        // ============ DATA ============
        const menuItems = [
            { id: 1, name: 'Coca-Cola', category: 'cool-drinks', price: 30, icon: '🥤' },
            { id: 2, name: 'Pepsi', category: 'cool-drinks', price: 30, icon: '🥤' },
            { id: 3, name: 'Sprite', category: 'cool-drinks', price: 25, icon: '🥤' },
            { id: 4, name: 'Orange Juice', category: 'fruit-juices', price: 50, icon: '🍊' },
            { id: 5, name: 'Mango Juice', category: 'fruit-juices', price: 55, icon: '🥭' },
            { id: 6, name: 'Watermelon Juice', category: 'fruit-juices', price: 45, icon: '🍉' },
            { id: 7, name: 'Vanilla Ice Cream', category: 'icecreams', price: 40, icon: '🍦' },
            { id: 8, name: 'Chocolate Ice Cream', category: 'icecreams', price: 45, icon: '🍫' },
            { id: 9, name: 'Strawberry Ice Cream', category: 'icecreams', price: 50, icon: '🍓' },
            { id: 10, name: 'Lays Chips', category: 'packet-snacks', price: 20, icon: '🍿' },
            { id: 11, name: 'Kurkure', category: 'packet-snacks', price: 20, icon: '🌽' },
            { id: 12, name: 'Biscuits', category: 'packet-snacks', price: 15, icon: '🍪' }
        ];

        // ============ STATE ============
        let cart = [];
        let currentCategory = 'all';

        // ============ DOM ELEMENTS ============
        const itemsGrid = document.getElementById('itemsGrid');
        const cartItems = document.getElementById('cartItems');
        const cartCount = document.getElementById('cartCount');
        const totalAmount = document.getElementById('totalAmount');
        const payBtn = document.getElementById('payBtn');
        const loading = document.getElementById('loading');
        const toast = document.getElementById('toast');

        // ============ LOAD CART FROM SERVER ============
        function loadCartFromServer() {
            fetch('/get-cart')
                .then(res => res.json())
                .then(data => {
                    if (data.cart) {
                        cart = data.cart;
                        updateCart();
                    }
                })
                .catch(err => console.error('Error loading cart:', err));
        }

        // ============ RENDER ITEMS ============
        function renderItems(category) {
            const filtered = category === 'all' 
                ? menuItems 
                : menuItems.filter(item => item.category === category);

            itemsGrid.innerHTML = filtered.map(item => `
                <div class="item-card">
                    <div class="item-icon">${item.icon}</div>
                    <div class="item-name">${item.name}</div>
                    <div class="item-price">₹${item.price}</div>
                    <button class="add-btn" onclick="addToCart(${item.id})">➕ Add to Cart</button>
                </div>
            `).join('');
        }

        // ============ CART FUNCTIONS ============
        function addToCart(id) {
            const item = menuItems.find(i => i.id === id);
            const existing = cart.find(i => i.id === id);
            
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ ...item, quantity: 1 });
            }
            
            // Save to server
            saveCartToServer();
            updateCart();
            showToast(`✅ Added ${item.name} to cart!`);
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            saveCartToServer();
            updateCart();
        }

        function updateQuantity(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    removeFromCart(id);
                    return;
                }
                saveCartToServer();
                updateCart();
            }
        }

        function saveCartToServer() {
            fetch('/update-cart-json', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cart: cart })
            }).catch(err => console.error('Error saving cart:', err));
        }

        function updateCart() {
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCount.textContent = totalItems;

            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            totalAmount.textContent = total;

            if (cart.length === 0) {
                cartItems.innerHTML = '<div class="empty-cart">Your cart is empty. Add some delicious items!</div>';
                payBtn.disabled = true;
            } else {
                cartItems.innerHTML = cart.map(item => `
                    <div class="cart-item">
                        <span>${item.icon} ${item.name} (₹${item.price})</span>
                        <div>
                            <button onclick="updateQuantity(${item.id}, -1)" style="padding:5px 10px;cursor:pointer;">−</button>
                            <span style="margin:0 10px;font-weight:bold;">${item.quantity}</span>
                            <button onclick="updateQuantity(${item.id}, 1)" style="padding:5px 10px;cursor:pointer;">+</button>
                            <button onclick="removeFromCart(${item.id})" style="padding:5px 10px;background:#e74c3c;color:white;border:none;border-radius:5px;cursor:pointer;margin-left:10px;">✕</button>
                        </div>
                    </div>
                `).join('');
                payBtn.disabled = false;
            }
        }

        // ============ CATEGORY FILTER ============
        document.querySelectorAll('.category-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentCategory = this.dataset.category;
                renderItems(currentCategory);
            });
        });

        // ============ PROCEED TO PAYMENT ============
        payBtn.addEventListener('click', function() {
            const total = parseInt(totalAmount.textContent);
            if (total === 0) {
                showToast('❌ Your cart is empty!');
                return;
            }
            window.location.href = '/classroom';
        });

        // ============ TOAST ============
        function showToast(message) {
            toast.textContent = message;
            toast.style.display = 'block';
            toast.style.background = message.includes('✅') ? '#27ae60' : '#e74c3c';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 3000);
        }

        // ============ INIT ============
        renderItems('all');
        loadCartFromServer();
    </script>
</body>
</html>
