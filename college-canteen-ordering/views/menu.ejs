<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= category %> - College Canteen</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <nav class="menu-nav">
            <a href="/">← Back to Home</a>
            <% if (user) { %>
                <a href="/logout" class="button button-secondary small-button">Logout</a>
            <% } else { %>
                <a href="/login" class="button button-primary small-button">Login</a>
                <a href="/signup" class="button button-secondary small-button">Sign Up</a>
            <% } %>
            <a href="/cart" class="button button-primary small-button">Cart (<%= cart ? cart.length : 0 %>)</a>
        </nav>
        
        <h1><%= category %></h1>
        
        <div class="menu-items">
            <% items.forEach(item => { %>
    <div class="menu-item" style="border: 1px solid #ddd; padding: 15px; margin-bottom: 10px; border-radius: 8px; display: flex; align-items: center; gap: 15px;">
        
        <!-- THIS IS THE NEW IMAGE CODE -->
        <% if (item.image_url) { %>
            <img src="<%= item.image_url %>" alt="<%= item.name %>" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;">
        <% } %>
        <!-- END OF NEW IMAGE CODE -->

        <div>
            <h3 style="margin: 0;"><%= item.name %></h3>
            <p style="margin: 5px 0; color: #666;">₹<%= item.price %></p>
            <!-- If you have a 'Add to cart' button/form, make sure it stays here! -->
        </div>

    </div>
<% }) %>
        </div>
        
        <% if (cart && cart.length > 0) { %>
        <div class="order-tab">
            <a href="/cart">🛒 View Cart (₹<%= cart.reduce((sum, item) => sum + (item.price * item.quantity), 0) %>)</a>
        </div>
        <% } %>
    </div>
</body>
</html>
