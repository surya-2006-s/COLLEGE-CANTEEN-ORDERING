<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload ID Card - College Canteen</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Styling for the new Roll Number section */
        .roll-number-section {
            margin-top: 30px;
            text-align: center;
            padding: 20px;
        }
        .roll-number-section label {
            display: block;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
            font-size: 18px;
        }
        .roll-number-section input {
            width: 80%;
            max-width: 350px;
            padding: 12px 15px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 18px;
            text-align: center;
            transition: border-color 0.3s;
            outline: none;
        }
        .roll-number-section input:focus {
            border-color: #ff6b6b;
        }
        .error-text {
            color: #ff4444;
            font-size: 14px;
            display: none;
            margin-top: 8px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Upload Your ID Card</h1>
        
        <div class="camera-section">
            <video id="video" width="400" height="300" autoplay></video>
            <canvas id="canvas" width="400" height="300" style="display: none;"></canvas>
            
            <div class="camera-controls">
                <button id="capture" class="button">Take Photo</button>
                <button id="uploadBtn" class="button" style="background: #28a745; margin-left: 10px;" onclick="document.getElementById('fileInput').click()">
                    📁 Upload Photo
                </button>
            </div>
            
            <form id="uploadForm" action="/upload-id" method="POST" enctype="multipart/form-data">
                <!-- Hidden input for Roll Number to be sent to the server -->
                <input type="hidden" id="rollNumberInput" name="rollNumber" value="">
                <input type="hidden" id="emailInput" name="studentEmail" value=""> <!-- NEW -->
                <input type="file" id="fileInput" name="idPhoto" accept="image/*" style="display: none;">
                
                <div id="preview" style="display: none; margin-top: 20px;">
                    <h3>Preview:</h3>
                    <img id="previewImage" width="400" height="300" style="border-radius: 10px; margin: 10px 0;">
                    
                    <!-- ===== NEW ROLL NUMBER INPUT ===== -->
                    <!-- ===== ROLL NUMBER AND EMAIL INPUT ===== -->
                    <div class="roll-number-section">
                        <label for="rollNumber">🎓 Enter Your Roll Number:</label>
                        <input type="text" id="rollNumber" placeholder="e.g. 22BCE1234" required>
                        <div id="rollError" class="error-text">⚠️ Please enter your Roll Number!</div>

                        <br><br>

                        <label for="studentEmail">📧 Enter Your Email (for updates):</label>
                        <input type="email" id="studentEmail" placeholder="student@klh.edu.in" required>
                        <div id="emailError" class="error-text">⚠️ Please enter a valid Email!</div>
                    </div>

                    <button type="button" onclick="validateAndSubmit()" class="button">Confirm & Continue</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const capture = document.getElementById('capture');
        const preview = document.getElementById('preview');
        const previewImage = document.getElementById('previewImage');
        const uploadForm = document.getElementById('uploadForm');
        const fileInput = document.getElementById('fileInput');
        const rollNumberInput = document.getElementById('rollNumber');
        const rollNumberHidden = document.getElementById('rollNumberInput');
        const rollError = document.getElementById('rollError');

        async function startCamera() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { facingMode: 'environment' } 
                });
                video.srcObject = stream;
            } catch (err) {
                alert('Camera access denied. Please upload a photo instead.');
            }
        }

        startCamera();

        // Handle "Take Photo" Button
        capture.addEventListener('click', () => {
            canvas.getContext('2d').drawImage(video, 0, 0, 400, 300);
            const imageData = canvas.toDataURL('image/jpeg');
            
            canvas.toBlob((blob) => {
                const file = new File([blob], 'id-photo.jpg', { type: 'image/jpeg' });
                
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                fileInput.files = dataTransfer.files;
                
                previewImage.src = imageData;
                preview.style.display = 'block';
                video.style.display = 'none';
                capture.style.display = 'none';
                document.getElementById('uploadBtn').style.display = 'none';
            }, 'image/jpeg');
        });

        // Handle "Upload Photo" Button
        fileInput.addEventListener('change', (e) => {
            if (e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    previewImage.src = e.target.result;
                    preview.style.display = 'block';
                    video.style.display = 'none';
                    capture.style.display = 'none';
                    document.getElementById('uploadBtn').style.display = 'none';
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        // ===== NEW VALIDATION FUNCTION =====
        function validateAndSubmit() {
            const rollValue = rollNumberInput.value.trim();

            // If Roll Number is empty, show error and stop
            if (rollValue === "") {
                rollError.style.display = 'block';
                rollNumberInput.style.borderColor = '#ff4444';
                return;
            }

            // Validation passed! Hide error, set the hidden input value, and submit the form
            rollError.style.display = 'none';
            rollNumberInput.style.borderColor = '#ddd';
            rollNumberHidden.value = rollValue; // Send the value to the server
            
            uploadForm.submit();
        }
    </script>
</body>
</html>
// ===== UPDATED VALIDATION FUNCTION =====
function validateAndSubmit() {
    const rollValue = document.getElementById('rollNumber').value.trim();
    const emailValue = document.getElementById('studentEmail').value.trim();
    
    let isValid = true;

    // Check Roll Number
    if (rollValue === "") {
        document.getElementById('rollError').style.display = 'block';
        document.getElementById('rollNumber').style.borderColor = '#ff4444';
        isValid = false;
    } else {
        document.getElementById('rollError').style.display = 'none';
        document.getElementById('rollNumber').style.borderColor = '#ddd';
    }

    // Check Email
    if (emailValue === "" || !emailValue.includes('@')) {
        document.getElementById('emailError').style.display = 'block';
        document.getElementById('studentEmail').style.borderColor = '#ff4444';
        isValid = false;
    } else {
        document.getElementById('emailError').style.display = 'none';
        document.getElementById('studentEmail').style.borderColor = '#ddd';
    }

    if (isValid) {
        // Set hidden fields to submit to server
        document.getElementById('rollNumberInput').value = rollValue;
        document.getElementById('emailInput').value = emailValue; // We'll add this hidden input below!
        uploadForm.submit();
    }
}
