<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - KLH Canteen</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; padding: 20px;
        }
        .container {
            background: white; padding: 40px; border-radius: 20px;
            text-align: center; width: 100%; max-width: 420px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }
        h1 { color: #333; margin-bottom: 10px; }
        .subtitle { color: #666; font-size: 14px; margin-bottom: 20px; }
        .amount { font-size: 48px; color: #667eea; margin: 25px 0; font-weight: bold; }
        .order-summary {
            background: #f8f9fa; padding: 15px; border-radius: 10px;
            margin: 20px 0; text-align: left;
        }
        .order-summary h3 { color: #333; margin-bottom: 10px; font-size: 14px; }
        .order-summary .item {
            display: flex; justify-content: space-between;
            padding: 5px 0; font-size: 14px; color: #555;
        }
        .order-summary .total {
            border-top: 2px solid #ddd; padding-top: 10px; margin-top: 10px;
            font-weight: bold; font-size: 16px; color: #333;
        }
        .payment-info { color: #666; font-size: 14px; margin-bottom: 20px; }
        .razorpay-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; padding: 15px 40px; border: none; border-radius: 10px;
            font-size: 18px; cursor: pointer; width: 100%; margin-top: 10px;
            transition: transform 0.2s;
        }
        .razorpay-btn:hover { transform: scale(1.02); }
        .razorpay-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .test-pay-btn {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        }
        .back-link {
            display: inline-block; margin-top: 20px;
            color: #667eea; text-decoration: none; font-size: 14px;
        }
        .back-link:hover { text-decoration: underline; }
        .error-msg {
            background: #fee; color: #c0392b; padding: 10px; border-radius: 8px;
            margin: 10px 0; display: none; font-size: 14px;
        }
        .success-msg {
            background: #e8f5e9; color: #2e7d32; padding: 10px; border-radius: 8px;
            margin: 10px 0; display: none; font-size: 14px;
        }
        .mode-badge {
            display: inline-block; padding: 5px 12px; border-radius: 20px;
            font-size: 12px; font-weight: bold; margin-bottom: 10px;
        }
        .mode-test { background: #fff3cd; color: #856404; }
        .mode-live { background: #d4edda; color: #155724; }
    </style>
</head>
<body>
    <div class="container">
        <h1>💳 Payment</h1>
        <p class="subtitle">KLH College Canteen</p>

        <% if (PAYMENT_MODE === 'TEST') { %>
            <span class="mode-badge mode-test">🧪 TEST MODE</span>
        <% } else { %>
            <span class="mode-badge mode-live">🔒 LIVE MODE</span>
        <% } %>

        <div class="amount">₹<%= total %></div>

        <div class="order-summary">
            <h3>📋 Order Summary</h3>
            <% if (typeof cart !== 'undefined' && cart && cart.length > 0) { %>
                <% cart.forEach(item => { %>
                    <div class="item">
                        <span><%= item.name %> x<%= item.quantity %></span>
                        <span>₹<%= item.price * item.quantity %></span>
                    </div>
                <% }); %>
                <div class="total">
                    <span>Total</span>
                    <span>₹<%= total %></span>
                </div>
            <% } else { %>
                <p style="color: #999; font-size: 14px;">No items in cart</p>
            <% } %>
        </div>

        <div id="errorMsg" class="error-msg"></div>
        <div id="successMsg" class="success-msg"></div>

        <% if (PAYMENT_MODE === 'TEST') { %>
            <!-- ==================== TEST MODE ==================== -->
            <div class="payment-info">🧪 Simulated payment — no real money will be charged.</div>
            <a href="/test-payment" style="display: block; text-decoration: none;">
                <button class="razorpay-btn test-pay-btn" type="button">
                    🧪 Proceed to Test Payment (₹<%= total %>)
                </button>
            </a>
        <% } else { %>
            <!-- ==================== RAZORPAY (UNCHANGED) ==================== -->
            <div class="payment-info">🔒 Secure payment powered by Razorpay</div>
            <button class="razorpay-btn" id="razorpay-pay-btn" type="button">Pay Now</button>
        <% } %>

        <a href="/cart" class="back-link" style="margin-top: 15px;">← Back to Cart</a>
    </div>

    <% if (PAYMENT_MODE !== 'TEST') { %>
    <script>
        const payButton = document.getElementById('razorpay-pay-btn');
        const errorMsg = document.getElementById('errorMsg');
        const successMsg = document.getElementById('successMsg');
        const razorpayKey = '<%= RAZORPAY_KEY_ID %>';

        if (!razorpayKey) {
            errorMsg.textContent = 'Razorpay is not configured on the server.';
            errorMsg.style.display = 'block';
            payButton.disabled = true;
        }

        payButton.addEventListener('click', async function (e) {
            e.preventDefault();
            payButton.disabled = true;
            payButton.textContent = 'Processing...';
            errorMsg.style.display = 'none';
            successMsg.style.display = 'none';

            try {
                const response = await fetch('/create-razorpay-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const order = await response.json();

                if (!response.ok || order.error || !order.order_id) {
                    throw new Error(order.error || 'Unable to create Razorpay order');
                }

                const options = {
                    key: razorpayKey,
                    amount: order.amount,
                    currency: order.currency,
                    name: 'KLH College Canteen',
                    description: 'Canteen Order Payment',
                    order_id: order.order_id,
                    handler: async function (paymentResponse) {
                        try {
                            const verifyRes = await fetch('/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: paymentResponse.razorpay_order_id,
                                    razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                    razorpay_signature: paymentResponse.razorpay_signature
                                })
                            });
                            const verifyData = await verifyRes.json();

                            if (verifyRes.ok && verifyData.success) {
                                successMsg.textContent = '✅ Payment successful! Redirecting...';
                                successMsg.style.display = 'block';
                                setTimeout(() => { window.location.href = '/'; }, 1500);
                            } else {
                                errorMsg.textContent = '❌ Verification failed: ' + (verifyData.message || 'Try again');
                                errorMsg.style.display = 'block';
                                payButton.disabled = false;
                                payButton.textContent = 'Pay Now';
                            }
                        } catch (verifyError) {
                            errorMsg.textContent = '❌ Verification failed. Contact canteen.';
                            errorMsg.style.display = 'block';
                            payButton.disabled = false;
                            payButton.textContent = 'Pay Now';
                        }
                    },
                    prefill: {
                        name: '<%= typeof user !== "undefined" && user && user.full_name ? user.full_name : "KLH Student" %>',
                        email: '<%= typeof user !== "undefined" && user && user.email ? user.email : "student@klh.edu.in" %>',
                        contact: '+919999999999'
                    },
                    theme: { color: '#667eea' },
                    modal: {
                        ondismiss: function () {
                            payButton.disabled = false;
                            payButton.textContent = 'Pay Now';
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response) {
                    errorMsg.textContent = '❌ Payment failed: ' + (response.error?.description || 'Try again');
                    errorMsg.style.display = 'block';
                    payButton.disabled = false;
                    payButton.textContent = 'Pay Now';
                });
                rzp.open();
            } catch (error) {
                errorMsg.textContent = '❌ Payment error: ' + error.message;
                errorMsg.style.display = 'block';
                payButton.disabled = false;
                payButton.textContent = 'Pay Now';
            }
        });
    </script>
    <% } %>
</body>
</html>
