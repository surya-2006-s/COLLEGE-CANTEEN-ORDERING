<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Canteen Ordering</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .welcome-text {
            text-align: center;
            color: #333;
            margin-bottom: 10px;
            font-size: 32px;
            font-weight: bold;
        }
        .sub-text {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 18px;
        }
        .login-prompt {
            text-align: center;
            background: #fff3cd;
            padding: 40px;
            border-radius: 15px;
            margin: 40px 0;
            border: 2px dashed #ffc107;
        }
        .login-prompt p {
            font-size: 20px;
            color: #856404;
            margin-bottom: 20px;
        }
        .auth-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }
        .auth-buttons .button {
            padding: 15px 40px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
            font-size: 18px;
        }
        .button-primary {
            background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
            color: white;
        }
        .button-secondary {
            background: white;
            color: #ff6b6b;
            border: 2px solid #ff6b6b;
        }
        .button-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255,107,107,0.4);
        }
        .button-secondary:hover {
            background: #ff6b6b;
            color: white;
        }
        .empty-message {
            text-align: center;
            padding: 40px;
            color: #666;
            font-size: 18px;
        }
        .order-tab {
            position: fixed;
            bottom: 20px;
            left: 20px;
            background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
            padding: 15px 25px;
            border-radius: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            z-index: 1000;
        }
        .order-tab a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 16px;
        }
        .categories {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 20px;
        }
        .category-card {
            background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-decoration: none;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
            font-size: 18px;
            font-weight: bold;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 30px rgba(0,0,0,0.3);
        }
    </style>
</head>
<body>
    <%- include('header') %>

    <div class="container">
        <h1 class="welcome-text">Welcome to College Canteen</h1>
        <p class="sub-text">Order your favorite food from anywhere in the college!</p>

        <!-- Check if user is logged in -->
        <% if (user) { %>
            <!-- User is logged in - Show Menu -->
            <% if (categories && categories.length > 0) { %>
                <div class="categories">
                    <% categories.forEach(category => { %>
                        <a href="/menu/<%= category.slug || category %>" class="category-card">
                            <%= category.name || category %>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-message">
                    <p>No menu categories available at the moment.</p>
                    <p style="font-size: 14px; color: #999; margin-top: 10px;">Please check back later.</p>
                </div>
            <% } %>
        <% } else { %>
            <!-- User is NOT logged in - Show Login Prompt -->
            <div class="login-prompt">
                <p>🔒 Please login or sign up to view the full menu and add items to your cart.</p>
                <div class="auth-buttons">
                    <a href="/login" class="button button-primary">🔐 Login</a>
                    <a href="/signup" class="button button-secondary">📝 Sign Up</a>
                </div>
            </div>
        <% } %>

        <!-- Order Tab (Cart) - Always visible if items in cart -->
        <% if (cart && cart.length > 0) { %>
            <div class="order-tab">
                <a href="/cart">🛒 View Order (₹<%= cart.reduce((sum, item) => sum + (item.price * item.quantity), 0) %>)</a>
            </div>
        <% } %>
    </div>
</body>
</html>